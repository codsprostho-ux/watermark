# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values before deploying.
# ------------------------------------------------------------------

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# --- Google Drive (service account) ---
# Paste the full contents of your service-account JSON key here as ONE LINE.
# (Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> Add Key -> JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# The Drive folder ID that will act as the root for all watermarked photos.
# Create a folder in Drive, share it with the service account's client_email
# as "Editor", then copy the ID from the folder's URL:
# https://drive.google.com/drive/folders/THIS_PART_IS_THE_ID
GDRIVE_ROOT_FOLDER_ID=

# --- Watermark settings ---
WATERMARK_LOGO_URL=            # optional: public URL to a PNG logo (transparent bg works best)
WATERMARK_TEXT=Dr. Anudeep Desai
WATERMARK_OPACITY=0.35         # 0 = invisible, 1 = fully opaque
WATERMARK_ROTATION_DEGREES=-30

# --- Jotform field labels (must match the exact question titles on your form) ---
FIELD_PATIENT_NAME=Patient Name
FIELD_DOCTOR_NAME=Doctor Name
FIELD_CASE_TYPE=Type of Case
FIELD_NOTES=Special Notes
FIELD_PHOTO_UPLOAD=Upload photo

# Shared secret to verify the incoming webhook really is from your Jotform form.
# Set the same value in Jotform's webhook URL as a query param, e.g.:
# https://your-server.com/webhook?secret=THIS_VALUE
WEBHOOK_SECRET=change-me-to-something-random
